{
  "security_groups": [
    {
      "id": "sg-db-prod",
      "name": "production-db",
      "rules": [
        {
          "protocol": "tcp",
          "port": 5432,
          "source": "10.0.0.0/16"
        }
      ]
    }
  ],
  "resources": [
    {
      "id": "vpc-prod",
      "type": "vpc",
      "name": "production-vpc"
    },
    {
      "id": "subnet-private",
      "type": "subnet",
      "name": "private-db-subnet"
    },
    {
      "id": "db-prod",
      "type": "database",
      "name": "production-postgres",
      "private": true
    }
  ]
}